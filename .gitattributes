# Keep Unity text assets normalized in git.
*.cs text diff=csharp
*.shader text
*.cginc text
*.hlsl text
*.asmdef text
*.asmref text
*.json text
*.inputactions text
*.meta text
*.unity text
*.prefab text
*.asset text
*.mat text
*.controller text
*.anim text
*.overrideController text

# Treat generated art and other media as binary.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.tga binary
*.psd binary
*.fbx binary
*.wav binary
*.mp3 binary
